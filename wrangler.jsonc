{
  // Cloudflare serves this site at https://micrui.net/truckee/flights/ .
  //
  // Workers Builds is connected to this repository. On every push to main (the
  // nightly job's commits included) it runs the build command set in the
  // Cloudflare dashboard:
  //
  //     mkdir -p dist/truckee && cp -r docs dist/truckee/flights
  //
  // and then `npx wrangler deploy`. The copy puts the pages at the path they
  // are served from, so docs/ itself stays as it is and GitHub Pages can keep
  // reading it. The route below is narrower than the personal site's claim on
  // micrui.net, so it wins for this path only.
  "name": "truckee-flights",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "micrui.net/truckee/flights*", "zone_name": "micrui.net" }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
